<p style="color: green"><%= notice %></p>

<% content_for :title, "Pokemons" %>

<h1>Pokemons</h1>

<div id="pokemons">
  <% @pokemons.each do |pokemon| %>
    <%= render pokemon %>
    <p>
      <%= pokemon.name %>
      <%= link_to "Show this pokemon", pokemon %>
    </p>
  <% end %>
</div>

<%= link_to "New pokemon", new_pokemon_path %>
<%= link_to "New pokemon with AI", new_with_ai_pokemons_path %>
